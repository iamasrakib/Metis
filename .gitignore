# ──────────────────────────────────────────────────────────
# Μῆτις (Metis) — Git Ignore
# ──────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Training artifacts
checkpoints/
checkpoints_*/
cache/
logs/
*.pt
*.pth
*.ckpt

# Data (keep structure, ignore large files)
data/*.txt
!data/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Benchmark outputs (machine-specific measured results)
benchmarks/results/

# Scratch / analysis outputs
test_output.txt
wf_verdicts.txt
wf_verdicts2.txt

# OS
*.log
*.tmp
